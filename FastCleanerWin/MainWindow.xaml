<Window x:Class="FastCleanerWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastCleaner"
        Icon="/Assets/ras.ico"
        Height="500"
        Width="880"
        MinHeight="420"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="FastCleaner"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock x:Name="StatusText"
                           Text="Remove app leftovers, without the clutter."
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#68758A"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Button Content="History"
                        Width="85"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="#E9EDF3"
                        Foreground="#38455A"
                        Click="HistoryButton_Click"/>

                <Border Background="#E9EDF3"
                        Padding="12,7">
                    <TextBlock x:Name="VersionText"
                               Text="v1.0.0"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#38455A"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="DropPanel"
                Grid.Row="2"
                AllowDrop="True"
                Drop="DropZone_Drop"
                DragOver="DropZone_DragOver"
                Background="White"
                BorderBrush="#C9D5EA"
                BorderThickness="1"
                Padding="30">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="Drop an app here"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Drop an .exe file or an application shortcut"
                           Margin="0,7,0,0"
                           FontSize="13"
                           Foreground="#748197"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="ResultsPanel"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="#D7E0ED"
                BorderThickness="1"
                CornerRadius="16"
                Padding="10">

            <ListView x:Name="FilesList"
                      ItemsSource="{Binding Files}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="#263247"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header=""
                                        Width="48">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="NAME"
                                        Width="155"
                                        DisplayMemberBinding="{Binding Name}"/>

                        <GridViewColumn Header="LOCATION"
                                        Width="340"
                                        DisplayMemberBinding="{Binding FullPath}"/>

                        <GridViewColumn Header="LAST MODIFIED"
                                        Width="135"
                                        DisplayMemberBinding="{Binding LastModified}"/>

                        <GridViewColumn Header="SIZE"
                                        Width="90"
                                        DisplayMemberBinding="{Binding Size}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Grid Grid.Row="4">
            <TextBlock Text="Review the files before removing them."
                       Foreground="#748197"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="ClearButton"
                        Content="Clean"
                        Width="90"
                        Height="36"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="ClearButton_Click"
                        Background="#E9EDF3"
                        Foreground="#38455A"/>

                <Button x:Name="DeleteButton"
                        Content="Remove selected"
                        Width="145"
                        Height="36"
                        Visibility="Collapsed"
                        Click="DeleteSelectedButton_Click"
                        Background="#3D6FEA"
                        Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>